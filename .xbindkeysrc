# Raise Volume
"pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+10 dwmblocks"
  XF86AudioRaiseVolume

# Lower Volume
"pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+10 dwmblocks"
  XF86AudioLowerVolume

# Toggle Mute
"pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+10 dwmblocks"
  XF86AudioMute
