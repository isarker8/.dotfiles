#!/bin/sh
# dwmblocks date block: no Python at runtime, one `date` + one `awk`.
#   Left click  : toggle Hijri / Gregorian (shown as dd/mm/yyyy)
#   Right click : notification with the full Hijri and Gregorian dates
#
# The data file holds names that are already shaped and reversed for dwm (which
# does no bidi). Dunst does its own bidi, so the notification uses the plain
# logical names kept in the arrays below instead.
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sb-date/data"
STATE_FILE=/tmp/dwmblocks_date_state
STATE=$(cat "$STATE_FILE" 2>/dev/null)
STATE=${STATE:-0}

# Left click toggles Hijri (0) / Gregorian (1)
if [ "$BLOCK_BUTTON" = 1 ]; then
    STATE=$((1 - STATE))
    echo "$STATE" > "$STATE_FILE"
fi

if [ ! -r "$DATA" ]; then
    date '+%H:%M | %d/%m/%Y'
    [ "$BLOCK_BUTTON" = 3 ] && notify-send -t 10000 "Date" "$(date '+%A %d %B %Y')"
    exit 0
fi

set -- $(date '+%H %M %u %Y %m %d')

# awk prints: line 1 = bar text, line 2 = full Hijri date, line 3 = full Gregorian date
OUT=$(awk -F'\t' -v H="$1" -v MIN="$2" -v WD="$3" -v Y="$4" -v MO="$5" -v D="$6" -v G="$STATE" '
function dig(s,   i, o, n) {
    n = split("٠ ١ ٢ ٣ ٤ ٥ ٦ ٧ ٨ ٩", A, " ")
    for (i = 1; i <= length(s); i++) o = o A[substr(s,i,1) + 1]
    return o
}
function pad(n) { return sprintf("%02d", n + 0) }
function dfc(y, m, d,   era, yoe, doy, doe) {  # days since 1970-01-01
    if (m <= 2) y--
    era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
}
BEGIN {
    today = dfc(Y + 0, MO + 0, D + 0)
    # plain (logical-order) names for the notification
    split("محرم|صفر|ربيع الأول|ربيع الثاني|جمادى الأولى|جمادى الآخرة|رجب|شعبان|رمضان|شوال|ذو القعدة|ذو الحجة", HM, "|")
    split("يناير|فبراير|مارس|أبريل|مايو|يونيو|يوليو|أغسطس|سبتمبر|أكتوبر|نوفمبر|ديسمبر", GM, "|")
    split("الاثنين|الثلاثاء|الأربعاء|الخميس|الجمعة|السبت|الأحد", DN, "|")
}
$1 == "T" && $2 + 0 <= today { start = $2 + 0; hy = $3; hm = $4 }   # table is sorted
END {
    hd = today - start + 1
    t = dig(H) ":" dig(MIN)

    # dd/mm/yyyy for the bar
    hijri_num = dig(pad(hd)) "/" dig(pad(hm)) "/" dig(hy)
    greg_num  = dig(pad(D))  "/" dig(pad(MO)) "/" dig(Y)

    # full dates for the notification, natural reading order: weekday day month year
    hijri_full = DN[WD + 0] " " dig(hd) " " HM[hm + 0] " " dig(hy) "هـ"
    greg_full  = DN[WD + 0] " " dig(D + 0) " " GM[MO + 0] " " dig(Y)

    print t " | " (G == 1 ? greg_num : hijri_num)
    print hijri_full
    print greg_full
}' "$DATA")

printf '%s\n' "$OUT" | head -n 1

# Right click: notification with both full dates
if [ "$BLOCK_BUTTON" = 3 ]; then
    notify-send -t 10000 "التاريخ" "$(printf '%s\n' "$OUT" | tail -n +2)"
fi
