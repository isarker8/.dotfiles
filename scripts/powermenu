#!/usr/bin/env bash

choice=$(printf '%s\n' \
    "󰐥 Shutdown" \
    " Restart" \
    " Lock" \
    "󰤄 Sleep" |
    rofi -dmenu -i -p "Power" -theme-str 'listview {lines: 2; columns: 2;}')

case "$choice" in
    "󰐥 Shutdown")
        loginctl poweroff 
        ;;
    " Restart")
        loginctl reboot
        ;;
    " Lock")
        slock
        ;;
    "󰤄 Sleep")
        loginctl suspend 
        ;;
esac
