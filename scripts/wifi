#!/bin/bash
#
# File: wifi_selector.sh
# Description: Quick Wi-Fi menu using NetworkManager (nmcli) and rofi

refresh() {
    kill -37 "$(pidof dwmblocks)" 2>/dev/null
}

usage() {
    echo "USAGE: $(basename "$0") -r"
    exit 1
}

case "$1" in
    -r|-d)
        selector() {
            rofi -dmenu -i -matching fuzzy -p "$1" \
                -theme-str 'listview {lines: 10;}'
        }
        ;;
    *)
        usage
        ;;
esac

wifi_enabled() {
    [[ "$(nmcli radio wifi)" == "enabled" ]]
}

scan_networks() {
    notify-send "Scanning for Wi-Fi networks..."
    nmcli device wifi rescan >/dev/null 2>&1
}

list_networks() {
    nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list | awk -F: '
        $2 != "" && !seen[$2]++ {
            marker = ($1 == "*") ? "●" : "○"
            sec = ($4 == "") ? "OPEN" : $4
            printf "%s %s  [%s%% | %s]\n", marker, $2, $3, sec
        }
    '
}

connect_network() {
    local ssid="$1" sec="$2" pass

    # If NetworkManager already has a saved profile for this SSID, connect directly
    if nmcli -t -f NAME connection show | grep -Fxq "$ssid"; then
        notify-send "Connecting to $ssid..."
        if nmcli connection up id "$ssid" >/dev/null 2>&1; then
            notify-send "Connected to $ssid"
            refresh
            return 0
        fi
    fi

    if [[ "$sec" == "OPEN" ]]; then
        notify-send "Connecting to $ssid..."
        if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
            notify-send "Connected to $ssid"
            refresh
        else
            notify-send "Failed to connect to $ssid"
        fi
    else
        pass=$(printf 'exit\n' | selector "Password for $ssid")
        [[ -z "$pass" || "$pass" == "exit" ]] && exit 0
        notify-send "Connecting to $ssid..."
        if nmcli device wifi connect "$ssid" password "$pass" >/dev/null 2>&1; then
            notify-send "Connected to $ssid"
            refresh
        else
            notify-send "Failed to connect to $ssid"
        fi
    fi
}

main() {
    local menu pick ssid sec action

    if ! wifi_enabled; then
        pick=$(printf 'turn wifi on\nexit\n' | selector "Wi-Fi is off")
        if [[ "$pick" == "turn wifi on" ]]; then
            nmcli radio wifi on && notify-send "Wi-Fi enabled"
            refresh
        fi
        exit 0
    fi

    menu=$(printf '%s\n' "turn wifi off" "rescan"; list_networks; printf 'exit\n')
    pick=$(printf '%s\n' "$menu" | selector "Wi-Fi")

    case "$pick" in
        ""|exit)
            exit 0
            ;;
        "turn wifi off")
            nmcli radio wifi off && notify-send "Wi-Fi disabled"
            refresh
            ;;
        "rescan")
            scan_networks
            main
            ;;
        *)
            # Extract SSID and security from "● SSID  [85% | WPA2]"
            ssid="${pick#* }"
            ssid="${ssid%  \[*}"
            sec="${pick##*| }"
            sec="${sec%\]}"

            if [[ "$pick" == "●"* ]]; then
                action=$(printf 'disconnect\nforget network\nback\n' | selector "$ssid")
                case "$action" in
                    "disconnect")
                        if nmcli connection down id "$ssid" >/dev/null 2>&1; then
                            notify-send "Disconnected from $ssid"
                            refresh
                        fi
                        ;;
                    "forget network")
                        if nmcli connection delete id "$ssid" >/dev/null 2>&1; then
                            notify-send "Forgot $ssid"
                            refresh
                        fi
                        ;;
                    "back")
                        main
                        ;;
                esac
            else
                connect_network "$ssid" "$sec"
            fi
            ;;
    esac
}

main
