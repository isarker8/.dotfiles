#!/usr/bin/env bash

# Array of disks and matching icons
DISKS=("/" "/home")
ICONS=(" " "󰋜 ")
N=${#DISKS[@]}

# State file: "INDEX FORMAT"
DISKS_FILE="/tmp/dwmblocks_disk_info"
[ -f "$DISKS_FILE" ] || echo "0 0" > "$DISKS_FILE"

read INDEX FORMAT < "$DISKS_FILE"

# Handle clicks FIRST so the output below reflects the change
# 1 = left, 2 = middle, 3 = right, 4 = scroll up, 5 = scroll down
case $BLOCK_BUTTON in
    1) FORMAT=$(( (FORMAT + 1) % 2 ))        ; echo "$INDEX $FORMAT" > "$DISKS_FILE" ;;
    3) notify-send -t 60000 "Disks" "$(dysk --color no -c free+mp+use+size 2>&1 || df -h)" ;;
    4) INDEX=$(( (INDEX + 1) % N ))          ; echo "$INDEX $FORMAT" > "$DISKS_FILE" ;;
    5) INDEX=$(( (INDEX + N - 1) % N ))      ; echo "$INDEX $FORMAT" > "$DISKS_FILE" ;;
    6) setsid -f "${TERMINAL:-alacritty}" -e "${EDITOR:-vim}" "$0" >/dev/null 2>&1 ;;
esac

CURRENT_DISK="${DISKS[$INDEX]}"
ICON="${ICONS[$INDEX]}"

PERCENT=$(df -h "$CURRENT_DISK" | awk 'NR==2 {print $5}')
SPACE=$(df -h "$CURRENT_DISK" | awk 'NR==2 {print $4}')

[ "$FORMAT" -eq 0 ] && INFO="$PERCENT" || INFO="$SPACE"

echo "$ICON$INFO"
