#!/usr/bin/env bash

layout1="gb"
name1="GB"

layout2="ara"
name2="AR"

statefile="$HOME/.cache/current-layout"

mkdir -p "$HOME/.cache"

# Initialise state to layout1 if it doesn't exist
if [ ! -f "$statefile" ]; then
    printf '%s\n' "$layout1" > "$statefile"
fi

current=$(cat "$statefile")

if [ "$current" = "$layout1" ]; then
    setxkbmap "$layout2"
    printf '%s\n' "$layout2" > "$statefile"
    notify-send "Keyboard Layout" "$name2"
else
    setxkbmap "$layout1"
    printf '%s\n' "$layout1" > "$statefile"
    notify-send "Keyboard Layout" "$name1"
fi

# Telling dwmblocks to refresh
pkill -RTMIN+11 dwmblocks
