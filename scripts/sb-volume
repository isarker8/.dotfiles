#!/bin/sh

SINK="@DEFAULT_AUDIO_SINK@"

refresh() {
    kill -44 "$(pidof dwmblocks)" 2>/dev/null
}

# Called from keybinds: volume.sh up|down|mute
case "$1" in
    up)   wpctl set-volume -l 1.0 "$SINK" 5%+ ; refresh ; exit 0 ;;
    down) wpctl set-volume "$SINK" 5%- ; refresh ; exit 0 ;;
    mute) wpctl set-mute "$SINK" toggle ; refresh ; exit 0 ;;
esac

# Called from dwmblocks mouse clicks
case $BLOCK_BUTTON in
    1) wpctl set-mute "$SINK" toggle ;;
    2) notify-send "Volume" "$(wpctl get-volume "$SINK" | awk '{print int($2 * 100)"%"}')" ;;
    3) setsid -f pavucontrol ;;
    4) wpctl set-volume -l 1.0 "$SINK" 5%+ ;;
    5) wpctl set-volume "$SINK" 5%- ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Read state AFTER any changes so the bar shows the new value
vol_info=$(wpctl get-volume "$SINK")
vol=$(echo "$vol_info" | awk '{print int($2 * 100)"%"}')

# Pick an icon from the default sink's node name
sink_name=$(wpctl inspect "$SINK" | awk -F'"' '/node.name/ {print $2; exit}')
case "$sink_name" in
    bluez_output.*) icon="󰋋" ;;   # bluetooth headphones/speaker
    *hdmi*)         icon="󰍹" ;;   # monitor / HDMI audio
    *)              icon="󰕾" ;;   # built-in speakers
esac

if echo "$vol_info" | grep -q "\[MUTED\]"; then
    echo "󰝟"
else
    echo "$icon $vol"
fi
