#!/bin/sh

LOCATION="${LOC:-${LAT},${LON}}"
CACHE_FILE="/tmp/sb-wttr"
MAX_AGE=1800 # Refresh every 30 minutes (1800 seconds)

case "$BLOCK_BUTTON" in
    1)
        setsid -f "${TERMINAL:-alacritty}" -e sh -c "curl -s 'wttr.in/${LOCATION}' | less -R" >/dev/null 2>&1
        ;;
    3)
        rm -f "$CACHE_FILE"
        ;;
esac

# Fetch new weather if cache doesn't exist or is older than MAX_AGE
if [ ! -f "$CACHE_FILE" ] || [ $(( $(date +%s) - $(stat -c %Y "$CACHE_FILE") )) -ge "$MAX_AGE" ]; then
    weather=$(curl -sf --max-time 5 "wttr.in/${LOCATION}?format=1" | tr -s ' ')
    if [ -n "$weather" ] && ! echo "$weather" | grep -qi "Unknown\|Sorry\|html"; then
        echo "$weather" > "$CACHE_FILE"
    fi
fi

# Print cached weather if available
if [ -s "$CACHE_FILE" ]; then
    cat "$CACHE_FILE"
else
    echo "󰖐 N/A"
fi
