#!/usr/bin/env python3

import sys
from datetime import datetime
import arabic_reshaper
from bidi.algorithm import get_display
from hijri_converter import Gregorian

HIJRI_MONTHS = [
    'محرم', 'صفر', 'ربيع الأول', 'ربيع الثاني', 'جمادى الأولى', 'جمادى الآخرة',
    'رجب', 'شعبان', 'رمضان', 'شوال', 'ذو القعدة', 'ذو الحجة',
]
GREG_MONTHS = [
    'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
    'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر',
]
DAYS = ['الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت', 'الأحد']

TRANS = str.maketrans('0123456789', '٠١٢٣٤٥٦٧٨٩')
now = datetime.now()
time_str = now.strftime('%H:%M').translate(TRANS)

if len(sys.argv) > 1 and sys.argv[1] == 'g':
    raw = (f'{DAYS[now.weekday()]} {str(now.day).translate(TRANS)} '
           f'{GREG_MONTHS[now.month - 1]} {str(now.year).translate(TRANS)}')
else:
    h = Gregorian(now.year, now.month, now.day).to_hijri()
    raw = (f'{str(h.day).translate(TRANS)} {HIJRI_MONTHS[h.month - 1]} '
           f'{str(h.year).translate(TRANS)}هـ')

# Reshape joining letters and apply BiDi reordering for non-bidi bars
date_str = get_display(arabic_reshaper.reshape(raw))
print(f'{time_str} | {date_str}')
