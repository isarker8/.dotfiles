# Homepage that vimb opens if started without a URI.
#set home-page=about:blank
set home-page=file:///home/isarker/.dotfiles/startpage.html
# allowing local file importing
set allow-file-access-from-file-urls=on

set scripts=on
set user-agent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
set html5-local-storage=on

# Set dark-mode
set dark-mode=on

# Hardware accel
set hardware-acceleration-policy=ondemand

# Geolocation
set geolocation=ask

# Notifications
set notification=ask

# Enables the site-specific compatibility workarounds.
set site-specific-quirks=true

# Enable or disable support for smooth scrolling.
set smooth-scrolling=true

# Path to the default download directory. If no download directory is set,
# download will be written into current directory. The following pattern will
# be expanded if the download is started '~/', '~user', '$VAR' and '${VAR}'.
set download-path=/home/isarker/Downloads/

# Command with placeholder '%s' called if form field is opened with $EDITOR to
# spawn the editor-like `x-terminal-emulator -e vim %s'. To use Gvim as the
# editor, it's necessary to call it with `-f' to run it in the foreground.
set editor-command=termite -e "x-terminal-emulator -e vim %s"

# If enabled the inputbox will be hidden whenever it contains no text.
set input-autohide=true

# Enable or disable the spell checking feature.
set spell-checking=true

# Set comma separated list of spell checking languages to be used for
# spell checking.
set spell-checking-languages=en_GB

# Enable or disable support for WebGL on pages.
set webgl=true

# While typing a search command, show where the pattern typed so far matches.
set incsearch=true

# Web Content Font Settings
set default-font=JetBrainsMono Nerd Font
set monospace-font=JetBrainsMono Nerd Font
set sans-serif-font=JetBrainsMono Nerd Font
set serif-font=JetBrainsMono Nerd Font

# Font Sizes
set font-size=17
set monospace-font-size=15
set default-zoom=120

# Shortcuts
shortcut-add d=https://duckduckgo.com/?q=$0
shortcut-add g=https://www.google.com/search?q=$0
shortcut-add y=https://www.youtube.com/results?search_query=$0
shortcut-add aw=https://wiki.archlinux.org/index.php?search=$0

# using ;v/a/V/A for media using mpv viewing (lowercase)/yt-dlp downloading (uppercase)
nnoremap ;v :set x-hint-command=:sh! vimb-media '<C-R>;' v<CR>;x
nnoremap ;a :set x-hint-command=:sh! vimb-media '<C-R>;' a<CR>;x
nnoremap ;V :set x-hint-command=:sh! vimb-media '<C-R>;' V<CR>;x
nnoremap ;A :set x-hint-command=:sh! vimb-media '<C-R>;' A<CR>;x

# Set default search engine
shortcut-default duck

# Keybindings
nmap + zI
nmap - zO
nmap = zz

# Colors.css from gtk-4.0 (set with pywal)
set input-css=color: var(--foreground); background-color: var(--background);
set completion-css=color: var(--foreground); background-color: var(--background);
set completion-hover-css=color: var(--background); background-color: var(--color4);
set completion-selected-css=color: var(--background); background-color: var(--color2);
set status-css=color: var(--foreground); background-color: var(--color8);
set status-ssl-css=color: var(--foreground); background-color: var(--color2);
set status-ssl-invalid-css=color: var(--foreground); background-color: var(--color1);
set input-error-css=color: var(--background); background-color: var(--color1);
