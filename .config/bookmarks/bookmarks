#!/bin/sh
set -eu

# Bookmark file
BOOKMARKS_FILE="${BOOKMARKS_FILE:-$HOME/dotfiles/.config/bookmarks/bookmarks.txt}"

# dmenu look
DMENU="dmenu -i -c -l 30 -p 'Bookmarks:'"

# Browsers
WATERFOX="$(command -v waterfox || true)"
HELIUM="$(command -v helium-browser || true)"
FALLBACK="$(command -v xdg-open || echo waterfox)"

# Ensure bookmark directory/file exists
mkdir -p "$(dirname "$BOOKMARKS_FILE")"

[ -f "$BOOKMARKS_FILE" ] || cat >"$BOOKMARKS_FILE" <<'EOF'
# Bookmarks
# Format:
# name :: https://example.com
#
# You can also just use:
# https://example.com
EOF

# Build bookmark list
emit() {
  grep -vE '^\s*(#|$)' "$BOOKMARKS_FILE" |
  while IFS= read -r line; do
    case "$line" in
      *"::"*)
        lhs="${line%%::*}"
        rhs="${line#*::}"

        lhs="$(printf '%s' "$lhs" | sed 's/[[:space:]]*$//')"
        rhs="$(printf '%s' "$rhs" | sed 's/^[[:space:]]*//')"

        printf '%s :: %s\n' "$lhs" "$rhs"
        ;;
      *)
        printf '%s :: %s\n' "$line" "$line"
        ;;
    esac
  done
}

# Select bookmark
choice="$(
  emit |
  sort |
  eval "$DMENU" ||
  true
)"

[ -n "$choice" ] || exit 0

# Extract URL
url="${choice##* :: }"

# Strip inline comments and trim
url="$(printf '%s' "$url" |
  sed -e 's/[[:space:]]\+#.*$//' \
      -e 's/[[:space:]]\/\/.*$//' \
      -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]]*$//')"

# Ensure scheme
case "$url" in
  http://*|https://*|file://*|about:*|chrome:*)
    ;;
  *)
    url="https://$url"
    ;;
esac

# Select browser
BROWSER="$(
  printf '%s\n' \
    "Waterfox" \
    "Helium Browser" |
  dmenu -i -c -l 2 \
        -p 'Open with:' ||
  true
)"

[ -n "$BROWSER" ] || exit 0

# Open bookmark
open_with() {
  cmd="$1"

  if [ -n "$cmd" ]; then
    nohup "$cmd" --new-tab "$url" >/dev/null 2>&1 &
    exit 0
  fi
}

case "$BROWSER" in
  "Waterfox")
    open_with "$WATERFOX"
    ;;

  "Helium Browser")
    open_with "$HELIUM"
    ;;
esac

# Fallback
nohup "$FALLBACK" "$url" >/dev/null 2>&1 &
