[global]
    monitor = 0
    follow = keyboard
    sort = update
    width = (250, 500)
    height = (0, 750)
    offset = (8, 45)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color="{color4}"
    font = JetBrainsMono Nerd Font 13
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[play_sound]
    summary = "*"
    script = ~/dotfiles/.config/dunst/notif.sh

[urgency_low]
    foreground = "{foreground}"
    background = "{background}"
    timeout = 5

[urgency_normal]
    foreground = "{foreground}"
    background = "{background}"
    timeout = 10

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "#ff0000"
    timeout = 0
