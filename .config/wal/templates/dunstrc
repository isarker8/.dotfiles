[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (8, 45)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color="{color4}"
    font = JetBrainsMono Nerd Font 11
    corner_radius = 1
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[urgency_low]
    foreground = "{foreground}"
    background = "{background}"
    timeout = 5

[urgency_normal]
    foreground = "{foreground}"
    background = "{background}"
    timeout = 10

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "#ff0000"
    timeout = 0
